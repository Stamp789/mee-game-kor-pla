---
import Icon from './Icon.astro';
import { url } from '../lib/mods';
const { page = 'home' } = Astro.props;
---
<header class="site-header">
  <a class="wordmark" href={url()} aria-label="ร้านเกมมีเกมก็แปล — หน้าแรก">
    <img src={url('assets/brand.webp')} width="36" height="36" alt="" />
    <span>มีเกมก็แปล<small>ร้านเกม · แปลไทย</small></span>
  </a>
  <nav class="desktop-nav" aria-label="เมนูหลัก">
    <a href={url('mods/')} aria-current={page === 'catalog' ? 'page' : undefined}>ชั้นวางแผ่น</a>
    <a href={url('#guide')}>กฎของร้าน</a>
    <a href={url('#about')}>เจ้าของร้าน</a>
  </nav>
  <div class="header-actions">
    <button class="donate-btn" type="button" data-support-open><span class="donate-coin" aria-hidden="true">฿</span><span>ช่วยค่าไฟ</span></button>
    <button class="lights-toggle round-button" type="button" aria-pressed="false" aria-label="เปลี่ยนเป็นโหมดกลางคืน"><span class="bulb" aria-hidden="true"></span></button>
    <button class="round-button search-open" aria-label="ค้นหาม็อด" type="button"><Icon name="search" size={18} /></button>
    <button class="menu-open round-button" aria-label="เปิดเมนู" aria-controls="mobile-menu" type="button"><span class="menu-lines"></span></button>
  </div>
</header>
<dialog id="mobile-menu" class="menu-dialog">
  <div class="dialog-top"><span class="micro">เดินดูในร้าน</span><button class="round-button dialog-close" type="button" aria-label="ปิดเมนู"><Icon name="close" /></button></div>
  <nav aria-label="เมนูมือถือ"><a href={url()}>หน้าร้าน</a><a href={url('mods/')}>ชั้นวางแผ่น</a><a href={url('mods/?saved=1')}>แผ่นที่จองไว้</a><a href={url('#guide')}>กฎของร้าน</a><a href={url('#support')}>ช่วยค่าไฟร้าน</a></nav>
</dialog>
