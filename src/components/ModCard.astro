---
import Icon from './Icon.astro';
import { cover, modUrl, version, provider, date, type Mod } from '../lib/mods';
import { modGenres } from '../lib/catalog';
import { searchTerms } from '../lib/search';
interface Props { mod: Mod; index?: number; editorial?: boolean; archive?: boolean; }
const { mod, archive = false } = Astro.props;
const isNew = Date.now() - new Date(`${mod.date}T00:00:00+07:00`).getTime() < 30 * 864e5;
---
<article class:list={['game-card', 'case', { 'archive-card': archive }]} style={`--c0:${mod.colors[0]};--c1:${mod.colors[1] || mod.colors[0]}`} data-id={mod.id} data-search={searchTerms(mod)} data-source={mod.source} data-genres={modGenres(mod).join(' ')} data-category={mod.category} data-date={mod.date} data-title={mod.title}>
  <div class="case-3d">
    <a class="case-front" href={modUrl(mod)} tabindex="-1" aria-hidden="true">
      <span class="case-band"><span>มีเกมก็แปล</span><span>แปลไทย</span></span>
      <img src={cover(mod)} alt="" loading="lazy" width="960" height="540" />
      <span class="case-name">{mod.thaiTitle}</span>
    </a>
    <span class="case-spine" aria-hidden="true"><span>{mod.title}</span></span>
  </div>
  <span class:list={['case-sticker', { 'is-new': isNew }]} aria-hidden="true">{isNew ? 'ใหม่!' : version(mod.version)}</span>
  <div class="case-label">
    <h3><a href={modUrl(mod)}>{mod.title}</a></h3>
    <p class="game-thai">{mod.thaiTitle}</p>
    <p class="case-meta"><span>{version(mod.version)}</span><span>{mod.gameBuild}</span>{archive && <span class="archive-card-date">{provider(mod.source)} · <time datetime={mod.date}>{date(mod.date)}</time></span>}</p>
  </div>
  <button class="round-button favorite-button" data-favorite={mod.id} aria-label={`จองแผ่น ${mod.title}`} aria-pressed="false" type="button"><Icon name="heart" size={15} /></button>
</article>
