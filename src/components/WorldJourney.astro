---
import { getMods, url, modUrl } from '../lib/mods';
import Icon from './Icon.astro';
const mods = await getMods();
const worlds = ['absolum', 'tales-of-berseria', 'i-am-setsuna'].map(id => mods.find(mod => mod.id === id)!);
---
<section class="journey-track" data-journey data-images={JSON.stringify(worlds.map(mod => url(`assets/portal-${mod.id}.jpg`)))} aria-label="การเดินทางสู่โลกเกมภาษาไทย">
  <h1 class="sr-only">มีเกมก็แปล — ทุกโลก ในภาษาของคุณ</h1>
  <span class="journey-stop journey-stop--passage" id="journey-passage" aria-hidden="true"></span>
  <span class="journey-stop journey-stop--worlds" id="journey-worlds" aria-hidden="true"></span>
  <div class="journey-stage">
    <div class="journey-poster" aria-hidden="true"><div class="journey-poster-glow"></div><div class="journey-poster-loop"><span>G</span></div><div class="journey-poster-stem"></div><div class="journey-poster-spores"></div></div>
    <canvas class="journey-canvas" aria-hidden="true"></canvas>
    <div class="journey-atmosphere" aria-hidden="true"></div>
    <div class="journey-topline micro"><span>AN INDEPENDENT TRANSLATION COLLECTIVE</span><span>EST. IN THE WORLDS WE LOVE</span></div>
    <div class="journey-caption journey-caption--intro" data-chapter="0">
      <p class="journey-eyebrow">BEYOND WORDS. INTO WORLDS.</p>
      <h2>ทุกโลก<br /><span>ในภาษาของคุณ</span></h2>
      <p class="journey-small">ม็อดแปลไทย จากคนรักเกม ถึงคนรักเกม</p>
    </div>
    <a class="journey-scroll" href="#journey-passage" data-intro-cue><span>SCROLL TO DISCOVER</span><i></i><span>↓</span></a>
    <div class="journey-caption journey-caption--passage" data-chapter="1" aria-hidden="true" inert>
      <p class="journey-eyebrow">01 / BREAK THE LANGUAGE BARRIER</p>
      <h2>เข้าไปลึกกว่า<br /><span>คำว่าเล่น</span></h2>
      <p>เมื่อเข้าใจทุกบทสนทนา<br />โลกที่เคยรู้จัก… ก็เปลี่ยนไป</p>
      <a class="journey-inline-link" href="#journey-worlds">เดินทางต่อ <Icon size={17} /></a>
    </div>
    <div class="journey-caption journey-caption--worlds" data-chapter="2" aria-hidden="true" inert>
      <p class="journey-eyebrow">02 / FIND YOUR NEXT WORLD</p>
      <h2>เรื่องราวถัดไป<span>รอคุณอยู่</span></h2>
      <div class="journey-world-links">{worlds.map((mod, i) => <a href={modUrl(mod)}><span class="micro">0{i+1}</span><span>{mod.title}</span><Icon size={15} /></a>)}</div>
    </div>
    <div class="journey-bottomline">
      <button class="journey-motion" type="button" aria-label="พักการเคลื่อนไหว" aria-pressed="false"><span class="journey-motion-bars" aria-hidden="true"><i></i><i></i><i></i></span><span data-journey-motion-label>พักฉาก</span></button>
      <span class="journey-chapter-label micro" aria-live="polite">01 / THE ORIGIN</span>
      <a href="#featured" class="journey-skip">ข้ามไปผลงาน <span>↗</span></a>
    </div>
    <div class="journey-progress" aria-hidden="true"><span></span></div>
    <div class="journey-cross journey-cross--left" aria-hidden="true">+</div><div class="journey-cross journey-cross--right" aria-hidden="true">+</div>
    <noscript><style>.journey-track{height:100svh!important}.journey-caption--intro{opacity:1!important}.journey-scroll,.journey-motion{display:none!important}</style></noscript>
  </div>
</section>
<script>import '../scripts/world-journey';</script>
