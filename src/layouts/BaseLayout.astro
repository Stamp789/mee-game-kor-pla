---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import PageMotion from '../components/PageMotion.astro';
import { url } from '../lib/mods';
import '../styles/global.css';
import '../styles/immersive.css';
import '../styles/journey.css';
import '../styles/universe.css';
import '../styles/page-motion.css';
interface Props { title?: string; description?: string; image?: string; page?: string; }
const { title = 'มีเกมก็แปล — ทุกโลก ในภาษาของคุณ', description = 'ค้นพบม็อดแปลเกมภาษาไทยจากมีเกมก็แปล พร้อมรายละเอียดเวอร์ชัน วิธีติดตั้ง และลิงก์ดาวน์โหลดจากผู้แปล', image, page } = Astro.props;
---
<!DOCTYPE html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08131e" />
    {page === 'not-found' && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site || Astro.url).href} />}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    <link rel="icon" href={url('assets/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body data-base={url()} data-page={page || 'home'}>
    <a href="#main" class="skip-link">ข้ามไปเนื้อหา</a>
    <div class="universe-atmosphere" aria-hidden="true"><i></i><i></i><i></i></div>
    {(page === 'catalog' || page === 'detail') && <PageMotion />}
    <div class="site-shell"><Header page={page} /><main id="main"><slot /></main><Footer /></div>
    <Search />
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script>import '../scripts/site-ui';</script>
  </body>
</html>
