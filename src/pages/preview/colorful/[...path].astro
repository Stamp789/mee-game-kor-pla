---
/**
 * Colorful memory preview (from the Codex prototype in E:\Codex\mod-memory-preview).
 * Every route renders the same shell; public/preview/colorful/archive.js reads the URL and
 * draws the home page, the mod library, a mod detail page, or the farewell notes.
 */
import { getMods, base, url } from '../../../lib/mods';

export async function getStaticPaths() {
  const mods = await getMods();
  return [
    { params: { path: undefined } },
    { params: { path: 'mods' } },
    { params: { path: 'farewell' } },
    ...mods.map(mod => ({ params: { path: `mods/${mod.id}` } })),
  ];
}

const asset = (file: string) => url(`preview/colorful/${file}`);
---
<!doctype html>
<html lang="th" data-site-base={base}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#f5f1e8">
<title>มีเกมก็แปล — คลังม็อดภาษาไทย (พรีวิว)</title>
<link rel="icon" href={url('assets/brand.webp')}>
<link rel="stylesheet" href={asset('archive.css')}>
</head>
<body>
<a class="skip" href="#main">ข้ามไปเนื้อหา</a>
<div id="site"></div>
<script is:inline type="module" src={asset('archive.js')}></script>
</body>
</html>
