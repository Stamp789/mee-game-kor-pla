---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ModCard from '../../components/ModCard.astro';
import { getMods, cover, url, date, version, provider, type Mod } from '../../lib/mods';
import { downloadUrl } from '../../lib/downloads';
export async function getStaticPaths() { return (await getMods()).map(mod => ({ params: { id: mod.id }, props: { mod } })); }
interface Props { mod: Mod; }
const { mod } = Astro.props;
const related = (await getMods()).filter(item => item.id !== mod.id && (item.category === mod.category || item.tags.some(tag => mod.tags.includes(tag)))).slice(0, 2);
const downloads = [
  { source: 'nexus', href: mod.nexus }, { source: 'drive', href: mod.drive }, { source: 'mediafire', href: mod.mediafire },
].filter(item => item.href).map(item => ({ ...item, href: downloadUrl(item.source, item.href!) })).sort((a, b) => Number(b.source === mod.source) - Number(a.source === mod.source));
const hasChecksum = /^[a-f0-9]{64}$/i.test(mod.sha);
---
<BaseLayout title={`${mod.title} — ม็อดภาษาไทย | มีเกมก็แปล`} description={mod.description.slice(0, 160)} image={cover(mod)} page="detail">
  <nav class="breadcrumb" aria-label="เส้นทางหน้า"><a href={url()}>หน้าแรก</a><span>/</span><a href={url('mods/')}>คลังม็อด</a><span>/</span><span aria-current="page">{mod.title}</span></nav>
  <section class="detail-heading"><div><p class="micro section-kicker">THAI TRANSLATION / {mod.code}</p><h1 class:list={['detail-title', { 'long-title': mod.title.length > 25 }]}>{mod.title}<span class="blue-text">.</span></h1><p class="detail-subtitle">{mod.thaiTitle} <span>·</span> {mod.tags.slice(0, 2).join(' / ')}</p></div><div class="detail-heading-actions"><a href="#download-panel" class="pill pill-blue">ดาวน์โหลดม็อด <Icon name="download" /></a><button type="button" data-favorite={mod.id} aria-pressed="false" class="round-button favorite-button" aria-label={`บันทึก ${mod.title}`}><Icon name="heart" /></button></div></section>
  <div class="detail-visual" style={`--detail-color:${mod.colors[0]}`}><img src={cover(mod)} alt={`ภาพปกเกม ${mod.title}`} width="1440" height="810" fetchpriority="high" /><div class="detail-visual-bottom"><span class="pill pill-light"><span class="status-dot"></span>ม็อดภาษาไทย · {mod.statusText}</span><span class="micro">A NEW WAY TO EXPERIENCE THE STORY ↗</span></div></div>
  <nav class="detail-nav" aria-label="หัวข้อรายละเอียด"><a href="#overview">รายละเอียด</a><a href="#installation">วิธีติดตั้ง</a><a href="#changelog">บันทึกอัปเดต</a><button class="share-button" type="button"><Icon name="copy" size={17} /> แชร์หน้านี้</button></nav>
  <div class="detail-layout" id="downloads"><div class="detail-main">
    <section id="overview" class="detail-section"><p class="micro section-kicker">01 / THE STORY, IN YOUR LANGUAGE</p><h2>เข้าใจโลกของ<br /><span class="muted">{mod.title}</span></h2><p class="detail-description">{mod.description}</p><div class="detail-tags">{mod.tags.map(tag => <span>{tag}</span>)}</div><div class="translator-line"><img src={url('assets/brand.webp')} width="46" height="46" alt="" /><div><span class="micro">THAI TRANSLATION BY</span><strong>{mod.translator}</strong></div><a href="https://www.facebook.com/profile.php?id=61593924362608" target="_blank" rel="noopener noreferrer" aria-label="ติดตามมีเกมก็แปลบน Facebook"><Icon /></a></div></section>
    <section id="installation" class="detail-section"><p class="micro section-kicker">02 / BEFORE YOUR ADVENTURE</p><h2>พร้อมเล่น<span class="muted">เป็นไทย</span></h2><p class="detail-note">ปิดเกมและสำรองไฟล์เดิมก่อนติดตั้ง ตรวจคำแนะนำล่าสุดจากหน้าดาวน์โหลดประกอบทุกครั้ง</p><ol class="install-list">{mod.install.map((step, index) => <li><span class="step-index">{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}</ol><div class="help-note"><span>↗</span><div><strong>ติดตั้งแล้วพบปัญหา?</strong><p>แจ้งชื่อเกม เวอร์ชันม็อด และภาพปัญหาให้ผู้แปลช่วยตรวจสอบ</p><a href="https://www.facebook.com/profile.php?id=61593924362608" target="_blank" rel="noopener noreferrer">ติดต่อผ่านเพจมีเกมก็แปล ↗</a></div></div></section>
    <section id="changelog" class="detail-section"><p class="micro section-kicker">03 / RELEASE NOTES</p><div class="changelog-heading"><h2>บันทึกอัปเดต</h2><span class="version-chip">{version(mod.version)}</span></div><p class="micro muted">วันที่ระบุในคลัง · {date(mod.date)}</p><ul class="changelog-list">{mod.changelog.map(item => <li>{item}</li>)}</ul>{hasChecksum && <div class="checksum"><span class="micro">SHA-256</span><code>{mod.sha}</code></div>}</section>
    <section class="detail-section purchase-section"><p class="micro section-kicker">04 / SUPPORT THE ORIGINAL CREATORS</p><h2>สนุกกับ<span class="muted">เกมแท้</span></h2><p>เลือกแหล่งซื้อเกม แล้วตรวจสอบว่ารุ่นที่ซื้อรองรับม็อดนี้</p><div class="purchase-links">{mod.purchaseLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer" class="purchase-link">{link.label}<Icon /></a>)}</div></section>
  </div><aside class="download-column"><section id="download-panel" class="download-panel"><div class="download-panel-top"><span class="micro">YOUR ADVENTURE STARTS HERE</span><span class="download-decor">↙</span></div><h2>รับม็อด<br />ภาษาไทย<span>.</span></h2><dl><div><dt>เวอร์ชันม็อด</dt><dd>{version(mod.version)}</dd></div><div><dt>รุ่นเกมที่ระบุ</dt><dd>{mod.gameBuild}</dd></div><div><dt>ขนาดไฟล์</dt><dd>{mod.size}</dd></div><div><dt>วันที่ในคลัง</dt><dd>{date(mod.date)}</dd></div></dl><div class="download-links">{downloads.map((item, i) => <a class:list={['pill', i === 0 ? 'pill-light' : 'pill-outline-light']} href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`รับม็อด ${mod.title} จาก ${provider(item.source)} (เปิดแท็บใหม่)`}>{provider(item.source)} <Icon name="download" size={18} /></a>)}</div><p class="download-footnote">เปิดหน้าดาวน์โหลดต้นทาง<br />ตรวจไฟล์ล่าสุดและความเข้ากันได้ก่อนติดตั้ง{downloads.some(item => item.source === 'nexus') && <><br />เข้าสู่ระบบ Nexus Mods เพื่อรับไฟล์</>}</p>{mod.post && <a href={mod.post} class="original-post" target="_blank" rel="noopener noreferrer">ดูโพสต์ต้นทาง <Icon size={15} /></a>}</section><div class="aside-credit"><span>MADE WITH CARE.</span><p>ม็อดโดยผู้แปลอิสระ<br />ภาพและตัวเกมเป็นของเจ้าของผลงาน</p></div></aside></div>
  <section class="related-section section-space"><div class="section-heading"><div><p class="micro section-kicker">KEEP EXPLORING</p><h2>โลกถัดไป<span class="muted">รอคุณอยู่</span></h2></div><a class="text-link" href={url('mods/')}>ดูม็อดทั้งหมด <Icon /></a></div><div class="related-grid">{related.map((item, index) => <ModCard mod={item} index={index} />)}</div></section>
</BaseLayout>
