---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Billboard from '../../components/Billboard.astro';
import Icon from '../../components/Icon.astro';
import ModCard from '../../components/ModCard.astro';
import { getMods, cover, url, date, version, provider, type Mod } from '../../lib/mods';
import { downloadUrl } from '../../lib/downloads';
export async function getStaticPaths() { return (await getMods()).map(mod => ({ params: { id: mod.id }, props: { mod } })); }
interface Props { mod: Mod; }
const { mod } = Astro.props;
const all = await getMods();
const related = all.filter(item => item.id !== mod.id && (item.category === mod.category || item.tags.some(tag => mod.tags.includes(tag)))).slice(0, 4);
const downloads = [
  { source: 'nexus', href: mod.nexus }, { source: 'drive', href: mod.drive }, { source: 'mediafire', href: mod.mediafire },
].filter(item => item.href).map(item => ({ ...item, href: downloadUrl(item.source, item.href!) })).sort((a, b) => Number(b.source === mod.source) - Number(a.source === mod.source));
const hasChecksum = /^[a-f0-9]{64}$/i.test(mod.sha);
const seatNo = (all.findIndex(item => item.id === mod.id) + 1);
---
<BaseLayout title={`${mod.title} — ม็อดภาษาไทย | ร้านเกมมีเกมก็แปล`} description={mod.description.slice(0, 160)} image={cover(mod)} page="detail">
  <nav class="breadcrumb shop-crumb" aria-label="เส้นทางหน้า"><a href={url()}>หน้าร้าน</a><span>/</span><a href={url('mods/')}>ชั้นวางแผ่น</a><span>/</span><span aria-current="page">{mod.title}</span></nav>
  <section class="street street--detail" style={`--c0:${mod.colors[0]};--c1:${mod.colors[1] || mod.colors[0]}`}>
    <Billboard mods={[mod]} heading="h1" detail />
    <div class="detail-actions"><button type="button" data-favorite={mod.id} aria-pressed="false" class="round-button favorite-button" aria-label={`จองแผ่น ${mod.title}`}><Icon name="heart" /></button><button class="round-button share-button" type="button" aria-label="คัดลอกลิงก์หน้านี้"><Icon name="copy" size={17} /></button><div class="detail-tags">{mod.tags.map(tag => <span>{tag}</span>)}</div></div>
  </section>

  <div class="detail-layout" id="downloads"><div class="detail-main">
    <section id="overview" class="detail-section handbill"><p class="handbill-kicker">ใบปลิว</p><h2>เรื่องย่อ</h2><p class="detail-description">{mod.description}</p></section>
    <section id="installation" class="detail-section handbill"><p class="handbill-kicker">ติดไว้ข้างจอ</p><h2>วิธีลงม็อด</h2><p class="detail-note">ปิดเกม แล้วสำรองไฟล์เดิมก่อนทุกครั้ง เช็กวิธีล่าสุดที่หน้าดาวน์โหลดประกอบด้วยนะ</p><ol class="install-list">{mod.install.map((step, index) => <li><span class="step-index">{index + 1}</span><p>{step}</p></li>)}</ol><div class="help-note"><strong>ลงแล้วมีปัญหา?</strong><p>แจ้งชื่อเกม เวอร์ชันม็อด และแคปหน้าจอมาได้เลย — <a href="https://www.facebook.com/profile.php?id=61593924362608" target="_blank" rel="noopener noreferrer">ทักเพจมีเกมก็แปล ↗</a></p></div></section>
    <section id="changelog" class="detail-section handbill"><p class="handbill-kicker">ประวัติการฉาย</p><div class="changelog-heading"><h2>บันทึกอัปเดต</h2><span class="version-chip">{version(mod.version)}</span></div><p class="muted">ลงชั้นวันที่ {date(mod.date)}</p><ul class="changelog-list">{mod.changelog.map(item => <li>{item}</li>)}</ul>{hasChecksum && <div class="checksum"><span class="micro">SHA-256</span><code>{mod.sha}</code></div>}</section>
    <section class="detail-section handbill purchase-section"><p class="handbill-kicker">อุดหนุนของแท้</p><h2>ซื้อเกมแท้</h2><p>เลือกร้านที่ซื้อ แล้วเช็กว่ารุ่นที่ซื้อใช้กับม็อดนี้ได้</p><div class="purchase-links">{mod.purchaseLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer" class="purchase-link">{link.label}<Icon size={16} /></a>)}</div></section>
  </div><aside class="download-column"><section id="download-panel" class="download-panel ticket">
    <div class="ticket-main">
      <p class="ticket-head"><span>มีเกมก็แปล</span><span>ตั๋วฟรี</span></p>
      <h2>{mod.thaiTitle}</h2>
      <p class="ticket-en">{mod.title}</p>
      <dl><div><dt>โรง</dt><dd>{mod.gameBuild}</dd></div><div><dt>ที่นั่ง</dt><dd>ไหนก็ได้ ({String(seatNo).padStart(2, '0')})</dd></div><div><dt>ฉบับ</dt><dd>{version(mod.version)}</dd></div><div><dt>ขนาด</dt><dd>{mod.size}</dd></div><div><dt>ผู้แปล</dt><dd>{mod.translator}</dd></div></dl>
      <div class="download-links">{downloads.map((item, i) => <a class:list={['ticket-link', { primary: i === 0 }]} href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`รับม็อด ${mod.title} จาก ${provider(item.source)} (เปิดแท็บใหม่)`}>โหลดจาก {provider(item.source)} <Icon name="download" size={18} /></a>)}</div>
      <p class="download-footnote">เปิดหน้าดาวน์โหลดต้นทาง เช็กไฟล์ล่าสุดก่อนลง{downloads.some(item => item.source === 'nexus') && <> · ต้องล็อกอิน Nexus Mods ก่อนโหลด</>}</p>
      {mod.post && <a href={mod.post} class="original-post" target="_blank" rel="noopener noreferrer">ดูโพสต์ต้นทาง <Icon size={15} /></a>}
    </div>
    <div class="ticket-stub" aria-hidden="true"><span>ADMIT ONE</span><b>{mod.code}</b></div>
  </section></aside></div>

  {related.length > 0 && <section class="shop-section related-section"><header class="sign-head"><h2 class="painted-head painted-head--small">เรื่องอื่นที่น่าดู</h2><a class="shop-link" href={url('mods/')}>ดูทั้งร้าน <Icon size={16} /></a></header><div class="case-grid">{related.map((item, index) => <ModCard mod={item} index={index} />)}</div></section>}
</BaseLayout>
