---
import BaseLayout from '../layouts/BaseLayout.astro';
import Billboard from '../components/Billboard.astro';
import ModCard from '../components/ModCard.astro';
import Icon from '../components/Icon.astro';
import { getMods, url, modUrl, cover, date } from '../lib/mods';
const mods = await getMods();
const pick = ['omori', 'tales-of-berseria', 'shenmue-i-and-ii', 'football-manager-27', 'absolum', 'dressmaker'].map(id => mods.find(mod => mod.id === id)).filter(Boolean) as typeof mods;
const featured = pick.length >= 3 ? pick : mods.slice(0, 6);
const showing = mods.slice(0, 8);
const shelf = mods.slice(8, 16);
---
<BaseLayout page="home" title="ร้านเกมมีเกมก็แปล — ม็อดแปลไทย">
  <section class="street" aria-labelledby="shop-title">
    <div class="neon-sign">
      <h1 id="shop-title" class="neon-main">มีเกมก็แปล</h1>
      <p class="neon-sub"><span>ร้านเกม</span><i>•</i><span>แปลไทย</span><i>•</i><span>เปิดทุกวัน</span></p>
    </div>
    <Billboard mods={featured} total={mods.length} />
    <div class="awning" aria-hidden="true"></div>
  </section>

  <section class="piggy" id="support" aria-labelledby="support-title">
    <div class="piggy-box" aria-hidden="true"><span class="piggy-slot"></span><span class="coin c-a">฿</span><span class="coin c-b">฿</span><span class="piggy-label">ตู้รับบริจาค</span></div>
    <div class="piggy-copy">
      <h2 id="support-title" class="painted-head painted-head--small">ช่วยค่าไฟร้านหน่อย</h2>
      <p class="hand">ทุกเกมในร้านแปลฟรี ถ้าชอบงานแปล อยากให้ร้านเปิดต่อ หยอดตู้ได้ตามสะดวก ไม่บังคับจ้า</p>
    </div>
    <button class="bb-cta piggy-cta" type="button" data-support-open>หยอดตู้ช่วยร้าน <Icon name="right" size={18} /></button>
  </section>

  <section class="shop-section" id="featured" aria-labelledby="showing-title">
    <header class="sign-head"><h2 id="showing-title" class="painted-head">เข้าฉายแล้ว</h2><p class="hand">เรื่องใหม่ล่าสุดของร้าน แปลไทยมาสด ๆ</p><a href={url('mods/?sort=latest')} class="shop-link">ดูโปรแกรมทั้งหมด <Icon size={16} /></a></header>
    <div class="poster-strip">
      {showing.map((mod, i) => (
        <a class="poster" href={modUrl(mod)} style={`--c0:${mod.colors[0]};--c1:${mod.colors[1] || mod.colors[0]};--tilt:${((i * 37) % 5) - 2}deg`}>
          <span class="poster-art"><img src={cover(mod)} alt="" width="960" height="540" loading="lazy" /></span>
          <span class="poster-thai">{mod.thaiTitle}</span>
          <span class="poster-en">{mod.title}</span>
          <span class="poster-date">เข้าฉาย {date(mod.date)}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="shop-section shelf-section" aria-labelledby="shelf-title">
    <header class="sign-head"><h2 id="shelf-title" class="painted-head">ชั้นวางแผ่น</h2><p class="hand">หยิบดูได้ ไม่ว่ากัน — ในร้านมี {mods.length} แผ่น</p><a href={url('mods/')} class="shop-link">เดินดูทั้งร้าน <Icon size={16} /></a></header>
    <div class="case-grid">{shelf.map((mod, index) => <ModCard mod={mod} index={index} />)}</div>
  </section>

  <section class="shop-section notice-board" id="guide" aria-labelledby="guide-title">
    <header class="sign-head"><h2 id="guide-title" class="painted-head">กฎของร้าน</h2><p class="hand">อ่านก่อนลงม็อดนะ เจ้าของร้านเตือนแล้ว</p></header>
    <ol class="notices">
      <li class="notice"><span class="notice-no">ข้อ 1</span><h3>เลือกแผ่นให้ตรงเครื่อง</h3><p>ดูให้ดีว่าม็อดรองรับเกมรุ่นไหน Steam หรือแพลตฟอร์มอื่น แล้วค่อยกดโหลดจากหน้าต้นทาง</p></li>
      <li class="notice"><span class="notice-no">ข้อ 2</span><h3>สำรองเซฟก่อนลง</h3><p>ก๊อปไฟล์เกมกับเซฟเก็บไว้ก่อนทุกครั้ง แล้วลงตามวิธีของแต่ละเกม ไม่งั้นอย่าหาว่าร้านไม่เตือน!</p></li>
      <li class="notice"><span class="notice-no">ข้อ 3</span><h3>เจอบั๊ก บอกร้านได้</h3><p>เล่นแล้วเจอปัญหา แจ้งชื่อเกม เวอร์ชันม็อด และแคปหน้าจอมาที่เพจ เจ้าของร้านจะรีบดูให้</p></li>
    </ol>
  </section>

  <section class="shop-section owner" id="about" aria-labelledby="owner-title">
    <figure class="polaroid"><img src={url('assets/brand.webp')} width="200" height="200" alt="โลโก้มีเกมก็แปล" loading="lazy" /><figcaption>เจ้าของร้าน</figcaption></figure>
    <div class="owner-letter">
      <h2 id="owner-title" class="painted-head painted-head--small">จากเจ้าของร้าน</h2>
      <p>เกมดี ๆ มันพาเราไปได้ไกล แต่ถ้าอ่านรู้เรื่องด้วย มันจะพาเราไปได้ลึกกว่าเดิมเยอะ ร้านนี้เลยตั้งใจแปลทุกบทสนทนาให้เป็นภาษาไทยที่อ่านแล้วรู้สึกตาม ไม่ใช่แค่อ่านออก</p>
      <p class="hand owner-sign">— มีเกมก็แปล By.Stamp Nattakit</p>
      <a href="https://www.facebook.com/profile.php?id=61593924362608" target="_blank" rel="noopener noreferrer" class="shop-link">ทักมาคุยที่เพจ <Icon size={16} /></a>
    </div>
  </section>

</BaseLayout>
